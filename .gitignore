# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.keystore
*.jks

# Xcode
ios/Config/Local.xcconfig
ios/build/
*.xcuserstate
xcuserdata/
DerivedData/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Supabase CLI cache
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
