# Supabase (https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Use either legacy anon key OR new publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional aliases (server reads these too)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Optional: personal access token for npm run disable:email-confirm
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Optional local migration/maintenance scripts only. The deployed app does not
# need or receive a service-role/secret key; privileged account provisioning is
# isolated in the Supabase facilities-auth Edge Function.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Employee sign-in uses ShiftFlow's existing 7shifts Punch-ID verification.
# Deploy supabase/functions/facilities-auth with JWT verification disabled; the
# valid Punch credential is verified before a Supabase session exists.
# Never copy a 7shifts API token or any Punch IDs into this app or database.
# Staff Tools owner SSO defaults to the production public verification key. The matching
# FACILITIES_OWNER_SIGNING_KEY belongs only in the Staff Tools Vercel project,
# never in this Facilities app or Supabase.

# Coordinated shared-device transition. Deploy/verify Facilities first; enable
# the matching Staff Tools sender last. Unset/false preserves legacy behavior.
STAFF_TOOLS_SESSION_TRANSITION_ENABLED=false
# Optional exact HTTPS origins; defaults retain production behavior.
STAFF_TOOLS_ORIGIN=
SHIFTFLOW_ORIGIN=
# Earlier sender-origin alias; leave blank when STAFF_TOOLS_ORIGIN is set.
STAFF_TOOLS_SESSION_TRANSITION_ORIGIN=
# Optional Ed25519 SPKI public key; configure the same test key in the broker.
STAFF_TOOLS_OWNER_PUBLIC_KEY=
# Optional SPKI DER Ed25519 PUBLIC key, base64; defaults to the existing owner public key.
STAFF_TOOLS_SESSION_TRANSITION_PUBLIC_KEY=

# Isolated staging requires explicit separate origins, a test owner public key,
# a separate NEXT_PUBLIC_SUPABASE_URL, and the known production hostname below.
# Set matching values in the separate project's Edge Function environment.
FACILITIES_ISOLATED_STAGING=false
FACILITIES_PRODUCTION_SUPABASE_HOSTNAME=rzwjremunktgceiojnup.supabase.co
# Optional private Sites staging access. Server-only; set the same secret in the
# separate auth broker. Ignored unless isolated staging is true; never NEXT_PUBLIC.
SHIFTFLOW_STAGING_API_TOKEN=
